{
    "manifest_version": 3,
    "name": "PostNL oAuth rewriter",
    "description": "Rewrites postnl:// to Home Assistant oAuth2 endpoint",
    "icons": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "version": "1.0.0",
    "permissions": [
      "webRequest"
    ],
    "host_permissions": [
      "*://*.postnl.nl/*"
    ],
    "background": {
      "service_worker": "service_worker.js"
    }
  }